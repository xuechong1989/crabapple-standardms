<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="xc.crabapple.standardms.module.sms.SmsMapper">

    <resultMap id="SmsValidCode" type="xc.crabapple.standardms.common.domain.dao.SmsDao">
        <id property="id" column="id_" jdbcType="BIGINT"/>
        <result property="mobile" column="mobile_" jdbcType="VARCHAR"/>
        <result property="validCode" column="valid_code_" jdbcType="VARCHAR"/>
        <result property="validCodeExp" column="valid_code_time_" jdbcType="VARCHAR"/>
        <result property="createUserId" column="create_user_id_" jdbcType="BIGINT"/>
        <result property="createTime" column="create_time_" jdbcType="VARCHAR"/>
        <result property="updateUserId" column="update_user_id_" jdbcType="BIGINT"/>
        <result property="updateTime" column="update_time_" jdbcType="VARCHAR"/>
    </resultMap>

    <insert id="create">
        INSERT INTO t_sms(id_,mobile_,valid_code_,valid_code_time_,create_user_id_,create_time_,update_user_id_,update_time_)
        VALUES(#{id},#{mobile},#{validCode},#{validCodeExp},#{createUserId},#{createTime},#{updateUserId},#{updateTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM t_sms WHERE id_=#{id}
    </delete>

    <select id="selectListByMobile" resultMap="SmsValidCode">
        SELECT * FROM t_sms WHERE mobile_=#{mobile}
    </select>

    <select id="selectByMobileAndCode" resultMap="SmsValidCode">
        SELECT * FROM t_sms WHERE mobile_=#{mobile} AND valid_code_=#{validCode}
    </select>

</mapper>