<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="xc.crabapple.standardms.module.properties.PropertiesMapper">

	<resultMap id="PropertiesDao" type="xc.crabapple.standardms.common.domain.dao.PropertiesDao">
		<id property="id" column="id_" jdbcType="BIGINT"/>
		<result property="cipher" column="cipher_" jdbcType="VARCHAR"/>
		<result property="name" column="name_" jdbcType="VARCHAR"/>
		<result property="key" column="key_" jdbcType="VARCHAR"/>
		<result property="value" column="value_" jdbcType="VARCHAR"/>
		<result property="desc" column="desc_" jdbcType="VARCHAR"/>
		<result property="createUserId" column="create_user_id_" jdbcType="BIGINT"/>
		<result property="createTime" column="create_time_" jdbcType="VARCHAR"/>
		<result property="updateUserId" column="update_user_id_" jdbcType="BIGINT"/>
		<result property="updateTime" column="update_time_" jdbcType="VARCHAR"/>
        <result property="type" column="type_" jdbcType="VARCHAR"/>
        <result property="status" column="status_" jdbcType="VARCHAR"/>
	</resultMap>


    <select id="selectList" resultMap="PropertiesDao">
        select *
        from t_properties
        <where>
            <if test="cipher != null">
                and cipher_  LIKE CONCAT('%', #{cipher},'%')
            </if>
            <if test="name != null">
                and name_ LIKE CONCAT('%', #{name},'%')
            </if>
            <if test="key != null">
                and key_ LIKE CONCAT('%', #{key},'%')
            </if>
            <if test="value != null">
                and value_ LIKE CONCAT('%',#{value},'%')
            </if>
            <if test="desc != null">
                and desc_ LIKE CONCAT('%', #{desc},'%')
            </if>
            <if test="createUserId != null">
                and create_user_id_ LIKE CONCAT('%', #{createUserId},'%')
            </if>
            <if test="createTime != null">
                and create_time_ LIKE CONCAT('%', #{createTime},'%')
            </if>
            <if test="updateUserId != null">
                and update_user_id_ LIKE CONCAT('%', #{updateUserId},'%')
            </if>
            <if test="updateTime != null">
                and update_time_ LIKE CONCAT('%', #{updateTime},'%')
            </if>
            <if test="type != null">
                and type_ LIKE CONCAT('%', #{type},'%')
            </if>
            <if test="status != null">
                and status_ LIKE CONCAT('%', #{status},'%')
            </if>
        </where>
    </select>

	<select id="selectSysProperties" resultMap="PropertiesDao">
		SELECT * FROM t_properties WHERE key_=#{key}
	</select>


</mapper>