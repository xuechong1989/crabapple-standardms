<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="xc.crabapple.standardms.module.systemlog.SystemlogMapper">

    <resultMap id="SystemlogDao" type="xc.crabapple.standardms.common.domain.dao.SystemlogDao">
        <id property="id" column="id_" jdbcType="BIGINT"/>
        <result property="module" column="module_" jdbcType="VARCHAR"/>
        <result property="operation" column="operation_" jdbcType="VARCHAR"/>
        <result property="account" column="account_" jdbcType="VARCHAR"/>
        <result property="username" column="username_" jdbcType="VARCHAR"/>
        <result property="mobile" column="mobile_" jdbcType="VARCHAR"/>
        <result property="content" column="content_" jdbcType="VARCHAR"/>
        <result property="apiName" column="api_name_" jdbcType="VARCHAR"/>
        <result property="apiParam" column="api_param_" jdbcType="VARCHAR"/>
        <result property="clientip" column="clientip_" jdbcType="VARCHAR"/>
        <result property="userAgent" column="user_agent_" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time_" jdbcType="VARCHAR"/>
        <result property="createUserId" column="create_user_id_" jdbcType="BIGINT"/>
    </resultMap>

    <insert id="create">
        INSERT INTO t_systemlog
        (id_, module_, operation_, account_, username_, mobile_, content_, api_name_, api_param_, clientip_, user_agent_, create_time_, create_user_id_)
        VALUES
            (#{id}, #{module}, #{operation}, #{account}, #{username}, #{mobile}, #{content}, #{apiName}, #{apiParam}, #{clientip}, #{userAgent}, #{createTime}, #{createUserId})
    </insert>
    
    <select id="selectList" resultMap="SystemlogDao">
        select *
        from t_systemlog
        <where>
            <if test="module != null">
                and module_  LIKE CONCAT('%', #{module},'%')
            </if>
            <if test="operation != null">
                and operation_ LIKE CONCAT('%', #{operation},'%')
            </if>
            <if test="account != null">
                and account_ LIKE CONCAT('%', #{account},'%')
            </if>
            <if test="username != null">
                and username_ LIKE CONCAT('%',#{username},'%')
            </if>
            <if test="mobile != null">
                and mobile_ LIKE CONCAT('%', #{mobile},'%')
            </if>
            <if test="content != null">
                and content_ LIKE CONCAT('%', #{content},'%')
            </if>
            <if test="apiName != null">
                and api_name_ LIKE CONCAT('%', #{apiName},'%')
            </if>
            <if test="apiParam != null">
                and api_param_ LIKE CONCAT('%', #{apiParam},'%')
            </if>
            <if test="clientip != null">
                and clientip_ LIKE CONCAT('%', #{clientip},'%')
            </if>
            <if test="startTime != null and startTime!='' and endTime!= null and endTime != ''">
                and create_time_ between #{startTime} and #{endTime}
            </if>
        </where>
    </select>


</mapper>